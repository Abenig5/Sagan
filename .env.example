# Postgres connection strings. These match the Docker container in docker-compose.yml.
# On Vercel, the Neon integration sets both (DATABASE_URL is pooled, the other direct).
DATABASE_URL="postgresql://sagan:sagan@localhost:5434/sagan_beauty"
DATABASE_URL_UNPOOLED="postgresql://sagan:sagan@localhost:5434/sagan_beauty"

# NextAuth — generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Used only by `npm run db:seed` to create the first admin account.
SEED_ADMIN_EMAIL="admin@saganbeauty.ch"
SEED_ADMIN_PASSWORD="change-me"

# Optional — set to send real emails via Resend (https://resend.com).
# If unset, booking emails are logged to the server console instead.
RESEND_API_KEY=""
EMAIL_FROM="Sagan Beauty <hello@saganbeauty.ch>"
SALON_NOTIFICATION_EMAIL="hello@saganbeauty.ch"
